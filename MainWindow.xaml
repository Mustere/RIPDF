<Window x:Class="RIPDF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RIPDF — PDF в JPEG-PDF"
        Height="760"
        Width="1100"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0B1020">
    <Window.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A1020" Offset="0" />
                <GradientStop Color="#1F2446" Offset="0.5" />
                <GradientStop Color="#152238" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Border Margin="32"
                Padding="28"
                CornerRadius="24"
                BorderThickness="1"
                BorderBrush="#5B6BFF66">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1B223A" Offset="0" />
                    <GradientStop Color="#101827" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock FontSize="34" FontWeight="Bold" Foreground="#F8FAFC" Text="RIPDF" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#C7D2FE"
                               FontSize="14"
                               Text="Растрирование многостраничного PDF в JPEG и сборка оптимизированного PDF." />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,28,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Margin="0,0,18,0" Padding="14" CornerRadius="16" Background="#111827" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Входной файл" FontWeight="SemiBold" Foreground="#E2E8F0" />
                            <DockPanel Margin="0,8,0,0">
                                <TextBox Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" />
                                <Button Content="Обзор" Width="96" Margin="8,0,0,0" Click="SelectInputFile_OnClick" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Padding="14" CornerRadius="16" Background="#111827" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Выходной файл" FontWeight="SemiBold" Foreground="#E2E8F0" />
                            <DockPanel Margin="0,8,0,0">
                                <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" />
                                <Button Content="Сохранить" Width="110" Margin="8,0,0,0" Click="SelectOutputFile_OnClick" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.1*" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>

                    <Border Margin="0,0,18,0" Padding="16" CornerRadius="18" Background="#111827" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Разрешение (DPI)" FontWeight="SemiBold" Foreground="#E2E8F0" />
                                <Border Grid.Column="1" Padding="10,4" CornerRadius="10" Background="#1D4ED8" BorderBrush="#60A5FA" BorderThickness="1">
                                    <TextBlock Text="{Binding Dpi}" Foreground="#EFF6FF" FontWeight="Bold" />
                                </Border>
                            </Grid>

                            <Slider Margin="0,10,0,0"
                                    Minimum="0"
                                    Maximum="9"
                                    Value="{Binding SelectedDpiPresetIndex, Mode=TwoWay}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    TickPlacement="BottomRight"
                                    Height="32" />

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="72" Foreground="#7C8CB8" FontSize="11" TextAlignment="Center" Grid.Column="0" />
                                <TextBlock Text="100" Foreground="#7C8CB8" FontSize="11" TextAlignment="Center" Grid.Column="1" />
                                <TextBlock Text="150" Foreground="#7C8CB8" FontSize="11" TextAlignment="Center" Grid.Column="2" />
                                <TextBlock Text="200" Foreground="#7C8CB8" FontSize="11" TextAlignment="Center" Grid.Column="3" />
                                <TextBlock Text="300" Foreground="#7C8CB8" FontSize="11" TextAlignment="Center" Grid.Column="4" />
                                <TextBlock Text="400" Foreground="#7C8CB8" FontSize="11" TextAlignment="Center" Grid.Column="5" />
                                <TextBlock Text="600" Foreground="#7C8CB8" FontSize="11" TextAlignment="Center" Grid.Column="6" />
                                <TextBlock Text="800" Foreground="#7C8CB8" FontSize="11" TextAlignment="Center" Grid.Column="7" />
                                <TextBlock Text="1000" Foreground="#7C8CB8" FontSize="11" TextAlignment="Center" Grid.Column="8" />
                                <TextBlock Text="1200" Foreground="#7C8CB8" FontSize="11" TextAlignment="Center" Grid.Column="9" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Padding="16" CornerRadius="18" Background="#111827" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Пользовательское значение" FontWeight="SemiBold" Foreground="#E2E8F0" />
                            <TextBox Margin="0,10,0,0"
                                     Height="38"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding DpiInputText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,8,0,0" Foreground="#94A3B8" FontSize="12" Text="Введите любое DPI, например: 240 или 1440" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="3" Margin="0,24,0,0" Padding="16" CornerRadius="18" Background="#111827" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="JPEG качество (%)" FontWeight="SemiBold" Foreground="#E2E8F0" />
                            <Border Grid.Column="1" Padding="10,4" CornerRadius="10" Background="#0F766E" BorderBrush="#5EEAD4" BorderThickness="1">
                                <TextBlock Text="{Binding JpegQuality}" Foreground="#ECFEFF" FontWeight="Bold" />
                            </Border>
                        </Grid>

                        <Slider Minimum="25" Maximum="100" Value="{Binding JpegQuality}" TickFrequency="5" IsSnapToTickEnabled="True" Height="32" />

                        <ProgressBar Height="12" Margin="0,18,0,0" Value="{Binding ProgressValue}" Maximum="100" />
                        <TextBlock Margin="0,10,0,0" Foreground="#BFDBFE" Text="{Binding StatusMessage}" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsRasterizationEnabled}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#E2E8F0" />
                                <TextBlock Text="Выполнить растрирование" VerticalAlignment="Center" Foreground="#E2E8F0" FontWeight="SemiBold" />
                                <Separator Width="1" Margin="16,0" Background="#475569" />
                                <CheckBox IsChecked="{Binding IsCheckFillEnabled}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#E2E8F0" />
                                <TextBlock Text="Проверить заливку" VerticalAlignment="Center" Foreground="#E2E8F0" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Grid.Column="1">
                                <Button Content="Старт" Width="150" Height="42" Click="RunConversion_OnClick" Style="{StaticResource RoundedButtonStyle}" />
                                <Button Content="Отмена" Width="150" Height="42" Margin="12,0,0,0" Background="#334155" BorderBrush="#64748B" Click="CancelConversion_OnClick" Style="{StaticResource RoundedButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
