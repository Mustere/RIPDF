<Window x:Class="RIPDF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RIPDF — PDF в JPEG-PDF"
        Height="600"
        Width="980"
        WindowStartupLocation="CenterScreen"
        Background="#0B1020">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0A1020" Offset="0" />
                <GradientStop Color="#1F2446" Offset="0.5" />
                <GradientStop Color="#152238" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Border Margin="32"
                Padding="28"
                CornerRadius="24"
                BorderThickness="1"
                BorderBrush="#55FFFFFF">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#33FFFFFF" Offset="0" />
                    <GradientStop Color="#16FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock FontSize="34" FontWeight="Bold" Text="RIPDF" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="#C7D2FE"
                               FontSize="14"
                               Text="Растрирование многостраничного PDF в JPEG и сборка оптимизированного PDF." />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,28,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="Входной файл" FontWeight="SemiBold" />
                        <DockPanel Margin="0,8,0,0">
                            <TextBox Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center" />
                            <Button Content="Обзор" Width="96" Click="SelectInputFile_OnClick" />
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Выходной файл" FontWeight="SemiBold" />
                        <DockPanel Margin="0,8,0,0">
                            <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" Height="36" VerticalContentAlignment="Center" />
                            <Button Content="Сохранить" Width="110" Click="SelectOutputFile_OnClick" />
                        </DockPanel>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="Разрешение (DPI)" FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0" Text="{Binding Dpi}" />
                        <Slider Minimum="72" Maximum="1200" Value="{Binding Dpi}" TickFrequency="24" IsSnapToTickEnabled="True" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="JPEG качество (%)" FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,0" Text="{Binding JpegQuality}" />
                        <Slider Minimum="25" Maximum="100" Value="{Binding JpegQuality}" TickFrequency="5" IsSnapToTickEnabled="True" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,24,0,0">
                    <ProgressBar Height="12" Value="{Binding ProgressValue}" Maximum="100" />
                    <TextBlock Margin="0,8,0,0" Foreground="#BFDBFE" Text="{Binding StatusMessage}" />

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Старт" Width="140" Click="RunConversion_OnClick" />
                        <Button Content="Отмена" Width="140" Background="#334155" BorderBrush="#64748B" Click="CancelConversion_OnClick" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
